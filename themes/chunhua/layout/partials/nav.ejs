<%
  var curPath = page.path || '';
  function isActive(u) {
    if (u === '/') return curPath === 'index.html' || curPath === '';
    return curPath.indexOf(u.replace(/^\//, '')) === 0;
  }
  var firstChannel = theme.channels && theme.channels[0];
%>
<header class="nav" id="nav">
  <div class="nav-inner">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= theme.brand.name %>">
      <span class="brand-avatar"><img src="<%- url_for('/img/avatar.png') %>" alt=""></span>
      <span class="brand-text">
        <strong><%= theme.brand.name %></strong>
        <em><%= theme.brand.en %></em>
      </span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      <% theme.menu.forEach(function (item) { %>
        <a href="<%- url_for(item.url) %>" class="<%= isActive(item.url) ? 'is-active' : '' %>"><%= item.name %></a>
      <% }); %>
    </nav>

    <div class="nav-actions">
      <% if (firstChannel) { %>
      <a class="nav-channel" href="<%= firstChannel.url %>" target="_blank" rel="noopener" aria-label="<%= firstChannel.name %>">
        <%- icon(firstChannel.icon) %>
        <span><%= firstChannel.name %></span>
      </a>
      <% } %>
      <button class="burger" id="burger" aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-top">
    <span class="drawer-brand"><%= theme.brand.name %></span>
    <button class="drawer-close" id="drawerClose" aria-label="关闭菜单"><%- icon('close') %></button>
  </div>
  <nav class="drawer-links">
    <% theme.menu.forEach(function (item) { %>
      <a href="<%- url_for(item.url) %>" class="<%= isActive(item.url) ? 'is-active' : '' %>"><%= item.name %></a>
    <% }); %>
  </nav>
  <div class="drawer-channels">
    <% (theme.channels || []).forEach(function (ch) { %>
      <a href="<%= ch.url %>" target="_blank" rel="noopener"><%- icon(ch.icon) %><span><%= ch.name %></span></a>
    <% }); %>
  </div>
  <p class="drawer-foot"><%= theme.brand.slogan %></p>
</div>
<div class="drawer-mask" id="drawerMask"></div>
